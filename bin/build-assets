#!/usr/bin/env php
<?php

declare(strict_types=1);

$autoloads = [
    __DIR__ . '/../vendor/autoload.php',
    __DIR__ . '/../../../autoload.php',
    getcwd() . '/vendor/autoload.php',
];
foreach ($autoloads as $autoload) {
    if (is_file($autoload)) { require_once $autoload; break; }
}
if (!class_exists(\InfluxIT\BuildAssets\Console\Application::class)) {
    fwrite(STDERR, "Composer autoload missing; run composer install.\n");
    exit(1);
}
exit((new \InfluxIT\BuildAssets\Console\Application())->run($argv));
